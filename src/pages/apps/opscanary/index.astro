---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { apps } from '../../../data/apps.js';
const app = apps.find(a => a.slug === 'opscanary');
---

<BaseLayout
  title={app.name}
  description="OpsCanary — Daily DevOps learning platform. Curated briefs from official AWS, Azure, GCP, Kubernetes, and Terraform docs. Scenario-based quizzes, free browser tools, 30 minutes a day."
  keywords="DevOps learning, Kubernetes daily, AWS digest, Terraform tutorials, GCP articles, CI/CD learning, DevSecOps, Platform Engineering, cloud native, daily tech brief, DevOps newsletter, OpsCanary"
  ogImage="https://wiplabs.app/icons/opscanary.png"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "OpsCanary",
    "description": "Daily DevOps learning platform delivering curated technical content from official AWS, Azure, GCP, Kubernetes, and Terraform documentation — in bite-sized briefs, scenario-based quizzes, and free browser utilities.",
    "url": "https://opscanary.com",
    "applicationCategory": "EducationApplication",
    "inLanguage": "en",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Organization",
      "name": "WIPLabs",
      "url": "https://wiplabs.app"
    },
    "sameAs": ["https://opscanary.com"]
  }}
>
  <style>
    /* ── Hero ── */
    .hero {
      background: linear-gradient(135deg, #061410 0%, #0d2218 55%, #071a22 100%);
      padding: 5rem 1.5rem 4rem;
      overflow: hidden;
      position: relative;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -60px; right: -60px;
      width: 460px; height: 460px;
      background: radial-gradient(circle, rgba(0,217,126,0.1) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: -80px; left: -80px;
      width: 360px; height: 360px;
      background: radial-gradient(circle, rgba(45,212,191,0.07) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(0,217,126,0.12);
      border: 1px solid rgba(0,217,126,0.35);
      color: #00d97e;
      font-size: 0.75rem;
      font-weight: 700;
      font-family: 'Syne', sans-serif;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.75rem;
      border-radius: 20px;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-size: 3.4rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.1;
      margin-bottom: 1.25rem;
    }

    .hero h1 span { color: #00d97e; }

    .hero-sub {
      color: rgba(255,255,255,0.7);
      font-size: 1.05rem;
      line-height: 1.75;
      margin-bottom: 2rem;
      max-width: 480px;
    }

    .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }

    .btn-visit {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #00d97e;
      color: #061410;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.8rem 1.6rem;
      border-radius: 10px;
      transition: opacity 0.2s, transform 0.2s;
    }
    .btn-visit:hover { opacity: 0.88; transform: translateY(-2px); }

    .btn-sub {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      color: rgba(255,255,255,0.7);
      font-family: 'Syne', sans-serif;
      font-weight: 600;
      font-size: 0.88rem;
      padding: 0.8rem 1.4rem;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.2);
      transition: all 0.2s;
    }
    .btn-sub:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.4); color: #fff; }

    .hero-stats {
      display: flex;
      gap: 2rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }

    .stat-item { text-align: left; }
    .stat-value { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: #00d97e; }
    .stat-label { font-size: 0.76rem; color: rgba(255,255,255,0.5); margin-top: 0.1rem; }

    /* ── Terminal card ── */
    .terminal-card {
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(0,217,126,0.2);
      border-radius: 14px;
      overflow: hidden;
      font-family: 'DM Mono', 'Fira Code', 'Courier New', monospace;
    }

    .terminal-bar {
      background: rgba(0,217,126,0.08);
      border-bottom: 1px solid rgba(0,217,126,0.15);
      padding: 0.65rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot.red   { background: #ff5f57; }
    .dot.yellow{ background: #febc2e; }
    .dot.green { background: #28c840; }

    .terminal-title {
      margin-left: 0.5rem;
      font-size: 0.72rem;
      color: rgba(255,255,255,0.4);
      font-family: 'Syne', sans-serif;
    }

    .terminal-body { padding: 1.25rem 1.25rem 1.5rem; }

    .t-date {
      font-size: 0.7rem;
      color: #00d97e;
      margin-bottom: 1rem;
      opacity: 0.8;
    }

    .t-article {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .t-article:last-of-type { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

    .t-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #00d97e;
      margin-top: 0.45rem;
      flex-shrink: 0;
      opacity: 0.7;
    }

    .t-title {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.4;
    }

    .t-tag {
      font-size: 0.62rem;
      font-family: 'Syne', sans-serif;
      color: #2dd4bf;
      background: rgba(45,212,191,0.1);
      border: 1px solid rgba(45,212,191,0.25);
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      display: inline-block;
      margin-top: 0.2rem;
    }

    .t-footer {
      margin-top: 1.1rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(255,255,255,0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.7rem;
      color: rgba(255,255,255,0.35);
    }

    .t-quiz {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      color: #00d97e;
      font-size: 0.7rem;
      opacity: 0.8;
    }

    /* ── Sections ── */
    .section { padding: 3rem 0; border-bottom: 1px solid var(--border); }
    .section:last-child { border-bottom: none; }
    .section > h2 { font-size: 1.3rem; margin-bottom: 0.4rem; }
    .section > p { color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem; }

    /* ── Features ── */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem;
      transition: border-color 0.2s;
    }
    .feature-card:hover { border-color: #00d97e40; }

    .feature-icon { font-size: 1.5rem; margin-bottom: 0.75rem; display: block; }
    .feature-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.4rem; }
    .feature-desc { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }

    /* ── Pillars ── */
    .pillars-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.25rem;
    }

    .pillar-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(0,217,126,0.07);
      border: 1px solid rgba(0,217,126,0.22);
      color: #00d97e;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: 'Syne', sans-serif;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
    }

    /* ── Meta grid ── */
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }

    .meta-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.25rem;
    }

    .meta-label { font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.08em; font-family: 'Syne', sans-serif; }
    .meta-value { font-weight: 600; font-size: 0.95rem; }

    /* ── Legal links ── */
    .legal-links { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
    .legal-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
      font-family: 'Syne', sans-serif;
      padding: 0.4rem 0.9rem;
      border: 1px solid var(--accent);
      border-radius: 6px;
      transition: background 0.2s;
    }
    .legal-link:hover { background: var(--accent-dim); }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .hero-inner { grid-template-columns: 1fr; }
      .hero-right { display: none; }
      .hero h1 { font-size: 2.4rem; }
      .hero-stats { gap: 1.5rem; flex-wrap: wrap; }
    }
  </style>

  <!-- Hero -->
  <div class="hero">
    <div class="hero-inner">
      <div class="hero-left">
        <div class="hero-badge"><img src="/icons/opscanary.png" alt="OpsCanary" style="width:16px;height:16px;border-radius:3px;vertical-align:middle;" /> Web App</div>
        <h1>Stay Current.<br /><span>30 Minutes.</span><br />Every Day.</h1>
        <p class="hero-sub">
          Curated DevOps briefs from official AWS, Azure, GCP, Kubernetes, and Terraform docs.
          Scenario-based quizzes. Free browser tools. No sign-up required.
        </p>
        <div class="hero-cta">
          <a href="https://opscanary.com" target="_blank" rel="noopener" class="btn-visit">
            Visit OpsCanary →
          </a>
          <a href="https://opscanary.com" target="_blank" rel="noopener" class="btn-sub">
            Subscribe Free →
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-value">10</div>
            <div class="stat-label">Pillars</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">30 min</div>
            <div class="stat-label">Per day</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">10+</div>
            <div class="stat-label">Free tools</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">Daily</div>
            <div class="stat-label">Updated</div>
          </div>
        </div>
      </div>

      <!-- Terminal mockup -->
      <div class="hero-right">
        <div class="terminal-card">
          <div class="terminal-bar">
            <div class="dot red"></div>
            <div class="dot yellow"></div>
            <div class="dot green"></div>
            <span class="terminal-title">OpsCanary — Today's Brief</span>
          </div>
          <div class="terminal-body">
            <div class="t-date">📅 Daily Brief · 3 articles · ~26 min</div>
            <div class="t-article">
              <div class="t-dot"></div>
              <div>
                <div class="t-title">Kubernetes Gateway API vs Ingress</div>
                <span class="t-tag">Kubernetes</span>
              </div>
            </div>
            <div class="t-article">
              <div class="t-dot"></div>
              <div>
                <div class="t-title">Terraform drift detection with -refresh-only</div>
                <span class="t-tag">Terraform</span>
              </div>
            </div>
            <div class="t-article">
              <div class="t-dot"></div>
              <div>
                <div class="t-title">AWS Lambda SnapStart for Java runtimes</div>
                <span class="t-tag">AWS</span>
              </div>
            </div>
            <div class="t-footer">
              <span>From official docs only</span>
              <span class="t-quiz">🎯 Take quiz →</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="container">

    <!-- Features -->
    <section class="section" id="features">
      <h2>What's inside?</h2>
      <p>Everything a working DevOps engineer needs to stay sharp — without the noise.</p>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">📰</span>
          <div class="feature-title">Daily Curated Briefs</div>
          <div class="feature-desc">3–5 original articles per day, written from official docs. Capped at 30 minutes so you can fit it into any routine.</div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🎯</span>
          <div class="feature-title">Scenario-Based Quizzes</div>
          <div class="feature-desc">Post-read practice challenges with real YAML, Terraform configs, and kubectl commands — not just theory.</div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">☁️</span>
          <div class="feature-title">10 DevOps Pillars</div>
          <div class="feature-desc">Kubernetes, AWS, Azure, GCP, Terraform, CI/CD, Observability, DevSecOps, Platform Engineering, and Data Infrastructure.</div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🔧</span>
          <div class="feature-title">Free Browser Utilities</div>
          <div class="feature-desc">JWT decoder, CIDR calculator, YAML converter, and more. No account needed — just open and use.</div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📧</span>
          <div class="feature-title">Daily Email Digest</div>
          <div class="feature-desc">Subscribe to receive your daily brief in your inbox. Unsubscribe anytime. Browsing is always free without sign-up.</div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📖</span>
          <div class="feature-title">Official Sources Only</div>
          <div class="feature-desc">Every article is authored from official AWS, Azure, GCP, Kubernetes, and Terraform documentation — not generic blog posts.</div>
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="section">
      <h2>Coverage</h2>
      <p>10 pillars covering the full cloud-native and DevOps landscape.</p>
      <div class="pillars-wrap">
        <span class="pillar-tag">☸️ Kubernetes</span>
        <span class="pillar-tag">🟠 AWS</span>
        <span class="pillar-tag">🔵 Azure</span>
        <span class="pillar-tag">🟡 GCP</span>
        <span class="pillar-tag">🟣 Terraform</span>
        <span class="pillar-tag">🔄 CI/CD</span>
        <span class="pillar-tag">📡 Observability</span>
        <span class="pillar-tag">🛡️ DevSecOps</span>
        <span class="pillar-tag">🏗️ Platform Engineering</span>
        <span class="pillar-tag">🗄️ Data Infrastructure</span>
      </div>
    </section>

    <!-- App info -->
    <section class="section">
      <h2>App info</h2>
      <div class="meta-grid">
        <div class="meta-item">
          <div class="meta-label">Platform</div>
          <div class="meta-value">Web</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Access</div>
          <div class="meta-value">Free · No sign-up</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Language</div>
          <div class="meta-value">English</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Updated</div>
          <div class="meta-value">Daily</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Support</div>
          <div class="meta-value">{app.supportEmail}</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Developer</div>
          <div class="meta-value">WIPLabs</div>
        </div>
      </div>
    </section>

    <!-- Legal -->
    <section class="section">
      <h2>Legal & Support</h2>
      <p>Read our privacy policy or get in touch for any questions.</p>
      <div class="legal-links">
        <a href="https://opscanary.com/privacy" target="_blank" rel="noopener" class="legal-link">Privacy Policy</a>
        <a href="https://opscanary.com/terms" target="_blank" rel="noopener" class="legal-link">Terms of Use</a>
        <a href="/support" class="legal-link">Support</a>
        <a href="https://opscanary.com" target="_blank" rel="noopener" class="legal-link">Visit OpsCanary →</a>
      </div>
    </section>

  </div>
</BaseLayout>
