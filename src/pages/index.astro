---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps.js';
const featuredApps = apps.slice(0, 6);
---

<BaseLayout
  title="Home"
  description="Platform Engineering & Mobile Development for startups — Kubernetes, Terraform, CI/CD, iOS & Android. Fixed-price services by İhsan Özlü, Senior DevOps Engineer."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "WIPLabs",
        "url": "https://wiplabs.app",
        "description": "iOS, Android, and web apps built by İhsan Özlü — a Senior DevOps Engineer from Istanbul. Practical apps for business, DevOps, and everyday use.",
        "author": { "@type": "Person", "name": "İhsan Özlü", "url": "https://wiplabs.app/about" }
      },
      {
        "@type": "Organization",
        "name": "WIPLabs",
        "url": "https://wiplabs.app",
        "logo": "https://wiplabs.app/avatar.jpg",
        "description": "Indie app studio shipping practical iOS, Android, and web apps.",
        "founder": {
          "@type": "Person",
          "name": "İhsan Özlü",
          "jobTitle": "Senior DevOps Engineer",
          "url": "https://wiplabs.app/about",
          "sameAs": [
            "https://github.com/ihsanozlu",
            "https://linkedin.com/in/ihsan-özlü-32081a116"
          ]
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "hello@wiplabs.app",
          "contactType": "customer support"
        },
        "sameAs": ["https://github.com/ihsanozlu"]
      }
    ]
  }}
>
  <style>
    /* HERO */
    .hero {
      padding: 6rem 0 4rem;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -100px;
      right: -100px;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, var(--accent-dim) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: 'Syne', sans-serif;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .hero-label::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.4); }
    }

    .hero h1 {
      font-size: clamp(2rem, 5vw, 3.8rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 1.5rem;
      max-width: 800px;
    }

    .hero p {
      font-size: 1.15rem;
      color: var(--text-muted);
      max-width: 560px;
      margin-bottom: 2.5rem;
      line-height: 1.7;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    /* CURRENTLY BUILDING */
    .building-strip {
      background: var(--accent-dim);
      border: 1px solid var(--accent);
      border-radius: 10px;
      padding: 1rem 1.5rem;
      margin: 3rem 0;
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.9rem;
    }

    .building-strip strong {
      font-family: 'Syne', sans-serif;
      color: var(--accent);
    }

    /* APPS SECTION */
    .section {
      padding: 4rem 0;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
    }

    .section-header h2 {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .section-header a {
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 600;
    }

    .apps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .app-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.75rem;
      transition: border-color 0.2s, transform 0.2s;
      position: relative;
      overflow: hidden;
    }

    .app-card:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
    }

    .app-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .app-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: var(--bg-hover);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      border: 1px solid var(--border);
    }

    .app-card h3 {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
    }

    .app-card p {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.25rem;
    }

    .app-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .platform-tags {
      display: flex;
      gap: 0.4rem;
    }

    .platform-tag {
      font-size: 0.72rem;
      font-weight: 600;
      font-family: 'Syne', sans-serif;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: var(--bg-hover);
      color: var(--text-muted);
      border: 1px solid var(--border);
    }

    /* ABOUT STRIP */
    .about-strip {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 2.5rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2rem;
      align-items: center;
    }

    .about-strip h2 {
      font-size: 1.4rem;
      margin-bottom: 0.75rem;
    }

    .about-strip p {
      color: var(--text-muted);
      font-size: 0.95rem;
      max-width: 560px;
      line-height: 1.7;
    }

    .stats {
      display: flex;
      gap: 2rem;
    }

    .stat {
      text-align: center;
    }

    .stat-num {
      font-family: 'Syne', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent);
      line-height: 1;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
    }

    @media (max-width: 640px) {
      .about-strip { grid-template-columns: 1fr; }
      .stats { justify-content: flex-start; }
    }
  </style>

  <div class="container">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-label">Platform Engineering & Mobile Development</div>
      <h1>Cloud infra, CI/CD<br />& <span class="accent">apps that ship.</span></h1>
      <p>
        Senior DevOps Engineer with 8+ years across Kubernetes, Terraform, and Azure/AWS.
        I also build native iOS and Android apps. Fixed-price services, no surprises.
      </p>
      <div class="hero-cta">
        <a href="/services" class="btn btn-primary">View Services →</a>
        <a href="/apps" class="btn btn-outline">See my apps</a>
      </div>
    </section>

    <!-- SERVICES PREVIEW -->
    <section class="section" style="padding-top:0;">
      <div class="section-header">
        <h2>Services</h2>
        <a href="/services">View all →</a>
      </div>
      <div class="apps-grid">
        <div class="app-card">
          <div class="app-card-top">
            <div class="app-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L20.5 7v10L12 22 3.5 17V7z"/><circle cx="12" cy="12" r="2.5"/>
              </svg>
            </div>
            <span class="badge live">From $399</span>
          </div>
          <h3>Kubernetes Health Audit</h3>
          <p>Security review, performance analysis, cost report, and a 1-hour walkthrough. Delivered in 3 days.</p>
          <div class="app-card-footer">
            <a href="/services" style="font-size:0.85rem;color:var(--accent);font-weight:600;">Learn more →</a>
          </div>
        </div>
        <div class="app-card">
          <div class="app-card-top">
            <div class="app-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/><line x1="9" y1="12" x2="15" y2="12"/><polyline points="13 9 15 12 13 15"/>
              </svg>
            </div>
            <span class="badge live">From $699</span>
          </div>
          <h3>CI/CD Pipeline Setup</h3>
          <p>GitHub Actions or Azure DevOps — Docker, automated deploys, rollback strategy. Delivered in 5 days.</p>
          <div class="app-card-footer">
            <a href="/services" style="font-size:0.85rem;color:var(--accent);font-weight:600;">Learn more →</a>
          </div>
        </div>
        <div class="app-card">
          <div class="app-card-top">
            <div class="app-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="7" y="2" width="10" height="20" rx="2"/><line x1="7" y1="17" x2="17" y2="17"/>
              </svg>
            </div>
            <span class="badge live">From $2,500</span>
          </div>
          <h3>Mobile App Development</h3>
          <p>Native iOS and Android apps. Built by someone who has shipped real apps to the App Store and Play Store.</p>
          <div class="app-card-footer">
            <a href="/services" style="font-size:0.85rem;color:var(--accent);font-weight:600;">Learn more →</a>
          </div>
        </div>
      </div>
    </section>

    <div class="building-strip">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
      </svg>
      <div>
        <strong>Latest:</strong> Fixed-price DevOps services now available — Kubernetes audits, CI/CD pipelines, Terraform infra.
      </div>
      <a href="/services" class="badge" style="text-decoration:none;white-space:nowrap;">View →</a>
    </div>

    <!-- FEATURED APPS -->
    <section class="section">
      <div class="section-header">
        <h2>Apps</h2>
        <a href="/apps">View all →</a>
      </div>
      <div class="apps-grid">
        {featuredApps.map((app) => (
          <a href={`/apps/${app.slug}`} class="app-card">
            <div class="app-card-top">
              <div class="app-icon">
                {app.appIcon
                  ? <img src={app.appIcon} alt={app.name} style="width:100%;height:100%;border-radius:10px;object-fit:cover;" />
                  : <span style="font-size:1.5rem;">{app.cardIcon || '📦'}</span>
                }
              </div>
              <span class={`badge ${app.status}`}>{app.status === 'live' ? 'Live' : app.status === 'wip' ? 'WIP' : 'Soon'}</span>
            </div>
            <h3>{app.name}</h3>
            <p>{app.tagline}</p>
            <div class="app-card-footer">
              <div class="platform-tags">
                {app.platform.map(p => <span class="platform-tag">{p}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ABOUT STRIP -->
    <section class="section">
      <div class="about-strip">
        <div>
          <h2>Built by someone who ships infrastructure <span class="accent">and</span> apps.</h2>
          <p>
            8+ years in cloud infrastructure, Kubernetes, and CI/CD. I also build iOS and
            Android apps with SwiftUI and Kotlin — same engineering discipline, different
            stack.
          </p>
          <a href="/about" class="btn btn-outline" style="margin-top: 1.5rem;">Read more →</a>
        </div>
        <div class="stats">
          <div class="stat">
            <div class="stat-num">8+</div>
            <div class="stat-label">Years DevOps</div>
          </div>
          <div class="stat">
            <div class="stat-num">6</div>
            <div class="stat-label">Apps</div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>